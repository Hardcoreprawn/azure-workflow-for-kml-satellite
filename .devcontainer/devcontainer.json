{
  "name": "Canopex Dev",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker-compose.override.yml",
    "docker-compose.yml"
  ],
  "service": "devcontainer",
  "shutdownAction": "stopCompose",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "installZsh": false,
      "installOhMyZsh": false,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteEnv": {
    "HOME": "/home/vscode",
    "DEV_WORKSPACE": "${localWorkspaceFolder}",
    "UV_NO_SYNC": "1"
  },
  "postCreateCommand": "sudo chown -R vscode:vscode /opt/venv && uv sync --frozen --all-extras --no-install-project --inexact",
  "postStartCommand": "bash scripts/dev_stack.sh up",
  "forwardPorts": ["web:4280", "func:80", "orch:80"],
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": false
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "rust-lang.rust-analyzer"
      ]
    }
  }
}
