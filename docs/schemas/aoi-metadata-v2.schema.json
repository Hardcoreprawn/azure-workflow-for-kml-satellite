{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOI metadata emitted by ingestion.write_metadata",
  "type": "object",
  "required": ["$schema", "schema_version", "processing_id", "timestamp", "tenant_id", "feature", "geometry", "extended_data", "analysis"],
  "properties": {
    "$schema": {"const": "aoi-metadata-v2"},
    "schema_version": {"const": "2.0.0"},
    "processing_id": {"type": "string"},
    "timestamp": {"type": "string"},
    "tenant_id": {"type": "string"},
    "feature": {
      "type": "object",
      "required": ["name", "source_file", "feature_index", "description"],
      "properties": {
        "name": {"type": "string"},
        "source_file": {"type": "string"},
        "feature_index": {"type": "integer", "minimum": 0},
        "description": {"type": "string"}
      }
    },
    "geometry": {
      "type": "object",
      "required": ["crs", "source_geometry", "bbox", "buffered_bbox", "centroid", "area_ha", "buffer_m", "part_count", "exterior_ring_vertex_count", "interior_ring_count", "area_warning"],
      "properties": {
        "crs": {"const": "EPSG:4326"},
        "source_geometry": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "coordinates"],
              "properties": {
                "type": {"const": "Polygon"},
                "coordinates": {"$ref": "#/$defs/polygon"}
              }
            },
            {
              "type": "object",
              "required": ["type", "coordinates"],
              "properties": {
                "type": {"const": "MultiPolygon"},
                "coordinates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/polygon"}}
              }
            }
          ]
        },
        "bbox": {"$ref": "#/$defs/bbox"},
        "buffered_bbox": {"$ref": "#/$defs/bbox"},
        "centroid": {"$ref": "#/$defs/position"},
        "area_ha": {"type": "number", "minimum": 0},
        "buffer_m": {"type": "number"},
        "part_count": {"type": "integer", "minimum": 1},
        "exterior_ring_vertex_count": {"type": "integer", "minimum": 4},
        "interior_ring_count": {"type": "integer", "minimum": 0},
        "area_warning": {"type": "string"}
      }
    },
    "extended_data": {"type": "object", "additionalProperties": {"type": "string"}},
    "analysis": {
      "type": "object",
      "required": ["source", "pipeline_version"],
      "properties": {
        "source": {"const": "kml_satellite"},
        "pipeline_version": {"type": "string"}
      }
    }
  },
  "$defs": {
    "position": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "ring": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/position"}},
    "polygon": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ring"}},
    "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
  }
}
