{
  "$defs": {
    "CenterPoint": {
      "additionalProperties": true,
      "description": "AOI center point in latitude/longitude order for display and enrichments.",
      "properties": {
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "CenterPoint",
      "type": "object"
    },
    "PerAoiEnrichment": {
      "additionalProperties": true,
      "description": "Canonical enrichment evidence for one AOI within a run.",
      "properties": {
        "aoi_index": {
          "title": "Aoi Index",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "area_ha": {
          "title": "Area Ha",
          "type": "number"
        },
        "geometry": {
          "$ref": "#/$defs/PolygonGeometry"
        },
        "bbox": {
          "items": {},
          "title": "Bbox",
          "type": "array"
        },
        "center": {
          "$ref": "#/$defs/CenterPoint"
        },
        "source_geometry_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Geometry Type"
        },
        "plot_area_ha": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plot Area Ha"
        },
        "frame_plan": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Frame Plan",
          "type": "array"
        },
        "weather_daily": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            }
          ],
          "title": "Weather Daily"
        },
        "ndvi_stats": {
          "items": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Ndvi Stats",
          "type": "array"
        },
        "ndvi_raster_paths": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Ndvi Raster Paths",
          "type": "array"
        },
        "change_detection": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Detection"
        },
        "eudr": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eudr"
        },
        "errors": {
          "items": {},
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "aoi_index",
        "name",
        "area_ha",
        "geometry",
        "bbox",
        "center"
      ],
      "title": "PerAoiEnrichment",
      "type": "object"
    },
    "PolygonGeometry": {
      "additionalProperties": false,
      "description": "A Polygon or MultiPolygon represented as validated immutable parts.\n\nEach part owns one outer ring and zero or more inner rings. Membership is\nexplicit and never inferred from coordinate order or winding direction.\nCoordinates use longitude/latitude order in EPSG:4326.",
      "properties": {
        "parts": {
          "items": {
            "$ref": "#/$defs/PolygonPart"
          },
          "minItems": 1,
          "title": "Parts",
          "type": "array"
        },
        "crs": {
          "const": "EPSG:4326",
          "default": "EPSG:4326",
          "title": "Crs",
          "type": "string"
        }
      },
      "required": [
        "parts"
      ],
      "title": "PolygonGeometry",
      "type": "object"
    },
    "PolygonPart": {
      "additionalProperties": false,
      "description": "One outer ring and zero or more inner rings excluded from its area.",
      "properties": {
        "outer": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Outer",
          "type": "array"
        },
        "inners": {
          "default": [],
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "title": "Inners",
          "type": "array"
        }
      },
      "required": [
        "outer"
      ],
      "title": "PolygonPart",
      "type": "object"
    },
    "RunSummary": {
      "additionalProperties": true,
      "description": "Run-level enrichment summary, not canonical parcel evidence.",
      "properties": {
        "aoi_count": {
          "default": 0,
          "title": "Aoi Count",
          "type": "integer"
        },
        "multi_region": {
          "default": false,
          "title": "Multi Region",
          "type": "boolean"
        },
        "frame_plan": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Frame Plan",
          "type": "array"
        }
      },
      "title": "RunSummary",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Boundary contract for new enrichment manifest writes.",
  "properties": {
    "schema_version": {
      "const": "enrichment-manifest/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "run": {
      "additionalProperties": true,
      "title": "Run",
      "type": "object"
    },
    "summary": {
      "$ref": "#/$defs/RunSummary"
    },
    "geometry": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolygonGeometry"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "per_aoi_enrichment": {
      "items": {
        "$ref": "#/$defs/PerAoiEnrichment"
      },
      "title": "Per Aoi Enrichment",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "run",
    "summary"
  ],
  "title": "EnrichmentManifestV2",
  "type": "object"
}
